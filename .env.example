# Copy this file to .env and edit it. .env is gitignored, so your paths stay
# on your machine.
#
#     cp .env.example .env
#     set -a; source .env; set +a
#     python -m pipeline.train
#
# What lives here is what describes YOUR MACHINE: where the data is, where the
# run may write, how much the node can feed. What describes the RUN -- the
# learning rate, the number of epochs, the continuity term -- is a flag on
# `python -m pipeline.train` instead, so that the command which produced a
# result also records it. Run `python -m pipeline.train --help` for those.
#
# Every value below is optional; config.py has the default listed in the
# comment. Anything already exported in your shell wins over this file, and a
# command-line flag wins over both.


# --- Where things are ------------------------------------------------------

# The manifest pairing each image with its label. See manifests/ for the
# shape, and manifests/manifest.example.json for a minimal one. Overridable
# per run with `--manifest`.
# Default: manifests/manifest_ct.json
export MANIFEST_PATH=manifests/manifest_ct.json

# Where the run writes: checkpoints, TensorBoard logs and the dataset cache.
# Give it room -- the cache holds every volume of the manifest, preprocessed
# and resampled.
# Default: ./data
export DATASET_ROOT=./data


# --- What the node can feed ------------------------------------------------
#
# A batch is BATCH_SIZE x num_samples = 24 patches of 128^3, image and label,
# ~0.4 GiB, and every prefetched batch sits in /dev/shm until the main process
# takes it. If a run dies on "RuntimeError: unable to open shared memory
# object", turn PREFETCH_FACTOR and VAL_NUM_WORKERS down first, and check what
# the machine actually offers with `df -h /dev/shm`.

# Training loader workers. Default: 8
export NUM_WORKERS=8

# Validation loader workers -- it runs 6 batches an epoch against the training
# loader's 28, so it does not need the same fleet.
# Default: NUM_WORKERS // 4
export VAL_NUM_WORKERS=2

# Batches held ready per worker. The main /dev/shm knob. Default: 1
export PREFETCH_FACTOR=1
